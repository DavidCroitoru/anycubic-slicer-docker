#!/usr/bin/with-contenv bash

# Copy of the baseimage's svc-kasmvnc/run with ONE change: the websocket
# listener is bound to 127.0.0.1 instead of 0.0.0.0.
#
# Upstream starts Xvnc with `-disableBasicAuth -SecurityTypes None`, so port
# 6901 hands out the full desktop to anyone who can open it -- no password, no
# nginx, no basic auth. Under `network_mode: host` that means the whole LAN.
# nginx proxies to 127.0.0.1:6901, so loopback is all that is ever needed.
#
# Patching this at runtime was tried first and lost the race: s6 had already
# started Xvnc by the time the oneshot ran. Replacing the file is deterministic.

# Pass gpu flags if mounted
if ls /dev/dri/renderD* 1> /dev/null 2>&1 && [ -z ${DISABLE_DRI+x} ] && ! which nvidia-smi; then
  HW3D="-hw3d"
fi
if [ -z ${DRINODE+x} ]; then
  DRINODE="/dev/dri/renderD128"
fi

exec s6-setuidgid abc \
  /usr/local/bin/Xvnc $DISPLAY \
    ${HW3D} \
    -PublicIP 127.0.0.1 \
    -drinode ${DRINODE} \
    -disableBasicAuth \
    -SecurityTypes None \
    -AlwaysShared \
    -http-header Cross-Origin-Embedder-Policy=require-corp \
    -http-header Cross-Origin-Opener-Policy=same-origin \
    -geometry 1024x768 \
    -sslOnly 0 \
    -RectThreads 0 \
    -websocketPort 6901 \
    -interface 127.0.0.1 \
    -Log *:stdout:10
