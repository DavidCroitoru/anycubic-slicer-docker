# Container-side environment. install.sh generates the real runtime.env;
# this file documents every key it can write.

PUID=1000
PGID=1000
TZ=Europe/Bucharest

# --- web access -----------------------------------------------------------
# Basic auth is enabled if and only if PASSWORD is present. An EMPTY
# PASSWORD= line still enables it -- with an empty password. To run without
# auth, both lines below must be absent from the file.
#CUSTOM_USER=david
#PASSWORD=change-me

# Interface nginx binds to. 127.0.0.1 = reachable only from the machine
# running the container. 0.0.0.0 = every interface. install.sh defaults to
# 127.0.0.1 whenever auth is off.
BIND_ADDRESS=127.0.0.1

# --- gpu ------------------------------------------------------------------
DRINODE=/dev/dri/renderD128

# --- watchdog -------------------------------------------------------------
# A run shorter than WATCHDOG_MIN_UPTIME counts as a crash and backs off
# exponentially up to WATCHDOG_MAX_DELAY. 0 launches = unlimited.
WATCHDOG_MIN_UPTIME=20
WATCHDOG_MAX_DELAY=60
WATCHDOG_MAX_LAUNCHES=0
